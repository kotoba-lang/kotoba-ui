(ns theme-document)

;; Delivery 6 fifth (final) cutover — kotoba-ui composition layer
;; (css → html → shitsuke → liquid-glass-ui → **kotoba-ui**):
;;
;; A *logical theme document* is an ordinary `:document` value carrying
;; at least `:accent` (hex string). Rendering yields the cascade
;; layer-order + accent CSS-var declarations that theme-css injects.
;; Shell class/layout constants remain pure string helpers (same as form-A).
;;
;; Form-A `theme_core.kotoba` remains oracle for hex→rgba / accent decls /
;; layer / shell strings. Full theme-css host join (shitsuke+glass+shell)
;; stays .cljc. Capability-free. ≤4 value params on recursion.

;; --- i64 -> string --------------------------------------------------------

(defn digit-char [d :i64] :string
  (string-substring "0123456789" d (+ d 1)))

(defn nat-str [n :i64] :string
  (if (< n 10)
    (digit-char n)
    (string-concat (nat-str (quot n 10))
                   (digit-char (- n (* (quot n 10) 10))))))

(defn i64-str [n :i64] :string
  (if (< n 0)
    (string-concat "-" (nat-str (- 0 n)))
    (nat-str n)))

;; --- hex -----------------------------------------------------------------

(defn hex-digit-cp [cp :i64] :i64
  (if (if (>= cp 48) (if (<= cp 57) true false) false)
    (- cp 48)
    (if (if (>= cp 97) (if (<= cp 102) true false) false)
      (- cp 87)
      (if (if (>= cp 65) (if (<= cp 70) true false) false)
        (- cp 55)
        0))))

(defn hex-body [hex :string] :string
  (string-replace-all hex "#" ""))

(defn hex-digit-at [s :string i :i64] :i64
  (hex-digit-cp (string-code-point-at s i)))

(defn hex-byte-at [s :string i :i64] :i64
  (+ (* 16 (hex-digit-at s i)) (hex-digit-at s (+ i 1))))

(defn nibble-byte [s :string i :i64] :i64
  (* 17 (hex-digit-at s i)))

(defn rgba-of [r :i64 g :i64 b :i64 alpha :string] :string
  (string-concat "rgba("
                 (string-concat (i64-str r)
                                (string-concat ","
                                               (string-concat (i64-str g)
                                                              (string-concat ","
                                                                             (string-concat (i64-str b)
                                                                                            (string-concat ","
                                                                                                           (string-concat alpha ")")))))))))

(defn hex->rgba [hex :string alpha :string] :string
  (if (= (string-byte-length (hex-body hex)) 3)
    (rgba-of (nibble-byte (hex-body hex) 0)
             (nibble-byte (hex-body hex) 1)
             (nibble-byte (hex-body hex) 2)
             alpha)
    (rgba-of (hex-byte-at (hex-body hex) 0)
             (hex-byte-at (hex-body hex) 2)
             (hex-byte-at (hex-body hex) 4)
             alpha)))

(defn accent-tint [hex :string] :string
  (hex->rgba hex "0.55"))

(defn accent-tint-strong [hex :string] :string
  (hex->rgba hex "0.85"))

(defn join-nl [a :string b :string] :string
  (string-concat a (string-concat "\n" b)))

;; --- logical theme document ----------------------------------------------

(defn theme-doc [accent :string] :document
  (document-map :accent (document-string accent)))

(defn theme-doc-appearance [accent :string appearance :string] :document
  (document-map :accent (document-string accent)
                :appearance (document-string appearance)))

(defn accent-of [d :document] :string
  (option-value-of [:option :string]
    (document-string-value
      (option-value-of [:option :document]
        (document-get d :accent) (document-null)))
    "#000000"))

(defn appearance-of [d :document] :string
  (option-value-of [:option :string]
    (document-string-value
      (option-value-of [:option :document]
        (document-get d :appearance) (document-null)))
    "auto"))

;; --- accent CSS decls (same bytes as form-A) ------------------------------

(defn hig-tint-decl [hex :string] :string
  (string-concat "  --hig-color-tint: "
                 (string-concat hex ";")))

(defn glass-accent-tint-decl [hex :string] :string
  (string-concat "  --liquid-glass-accent-tint: "
                 (string-concat (accent-tint hex) ";")))

(defn glass-accent-strong-decl [hex :string] :string
  (string-concat "  --liquid-glass-accent-tint-strong: "
                 (string-concat (accent-tint-strong hex) ";")))

(defn accent-decls [hex :string] :string
  (join-nl (hig-tint-decl hex)
           (join-nl (glass-accent-tint-decl hex)
                    (glass-accent-strong-decl hex))))

(defn render-accent-decls [d :document] :string
  (accent-decls (accent-of d)))

;; --- cascade layer --------------------------------------------------------

(defn layer-order-css [] :string
  "@layer kotoba.hig, kotoba.glass;")

(defn layer-wrap [layer :string body :string] :string
  (string-concat "@layer "
                 (string-concat layer
                                (string-concat " {\n"
                                               (string-concat body "\n}")))))

(defn theme-header [accent-body :string] :string
  (join-nl (layer-order-css)
           (layer-wrap "kotoba.hig" accent-body)))

(defn render-theme-header [d :document] :string
  (theme-header (render-accent-decls d)))

;; --- shell class + layout constants ---------------------------------------

(defn shell-class [component :string] :string
  (string-concat "kotoba-shell__" component))

(defn readable-max-width [] :string "680px")
(defn grid-min-width [] :string "260px")
(defn sidebar-width [] :string "260px")
(defn sidebar-breakpoint [] :string "768px")

(defn appearance-value [mode :string] :string
  (if (string=? mode "light")
    "light"
    (if (string=? mode "dark")
      "dark"
      "")))

(defn render-appearance [d :document] :string
  (appearance-value (appearance-of d)))

;; --- identity -------------------------------------------------------------

(defn theme-digest [d :document] :string
  (document-sha256 d))

(defn theme-print [d :document] :string
  (document-print d))

(defn theme-read [s :string] :document
  (document-read s))

(defn main []
  (string-byte-length
   (join-nl (render-theme-header (theme-doc "#FF3CAC"))
            (shell-class "hero"))))
