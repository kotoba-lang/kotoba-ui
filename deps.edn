{:paths ["src"]
 ;; Composition layer: kotoba-ui.core requires shitsuke + liquid-glass-ui and
 ;; re-exports their public API, plus shell/theme. css is required by shell.style.
 :deps {io.github.kotoba-lang/shitsuke
        {:git/url "https://github.com/kotoba-lang/shitsuke.git"
         ;; button + select :attrs passthrough (silent-drop fixes)
         :git/sha "c0c156c4fd7654830682a58a5d1c8838f274a394"}
        io.github.kotoba-lang/liquid-glass-ui
        {:git/url "https://github.com/kotoba-lang/liquid-glass-ui.git"
         ;; inferred option fallback in token document renderer
         :git/sha "ddb0b1a85ecfdcd4e91ddacafb5e100752439860"}
        io.github.kotoba-lang/css
        {:git/url "https://github.com/kotoba-lang/css.git"
         ;; inferred option fallback in document renderer
         :git/sha "e10adeb678148eccb9a069819454ceb40ec8ee91"}
        io.github.kotoba-lang/byoubu-ui
        {:git/url "https://github.com/kotoba-lang/byoubu-ui.git"
         ;; backdrop plate + tier-1 posters
         :git/sha "e430808b5468d5af28a621817a275d721d88bdcb"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/design-quality
                      {:git/url "https://github.com/kotoba-lang/design-quality.git"
                       :git/sha "fb766e2f79c088de05e289554c9de049e7909bd3"}
                      io.github.kotoba-lang/compiler
                      {:git/url "https://github.com/kotoba-lang/compiler.git"
                       ;; inferred option fallback and contextual document keys
                       :git/sha "c3be07fb38bf457a159a2b304152e18693f9b0b6"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :local {:override-deps {io.github.kotoba-lang/shitsuke {:local/root "../shitsuke"}
                          io.github.kotoba-lang/liquid-glass-ui {:local/root "../liquid-glass-ui"}
                          io.github.kotoba-lang/css {:local/root "../css"}
                          io.github.kotoba-lang/design-quality {:local/root "../design-quality"}
                          io.github.kotoba-lang/byoubu-ui {:local/root "../byoubu-ui"}
                          io.github.kotoba-lang/byoubu {:local/root "../byoubu"}}}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
